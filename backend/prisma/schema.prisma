generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


model User {
  id            String   @id @default(uuid())
  fullName      String
  email         String   @unique
  passwordHash  String?
  avatarSeed    String?
  profilePhoto  String?  // Optional relative file path or Google avatar URL
  role          String   @default("employee")
  isOnboarded   Boolean  @default(false)

  googleId      String?  @unique
  authProvider  String   @default("local")
  emailVerified Boolean  @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  employees     Employee[]
  notifications Notification[]
  settings      UserSettings?
  leaves        Leave[]
  sentChatMessages     ChatMessage[]  @relation("SentChatMessages")
  receivedChatMessages ChatMessage[]  @relation("ReceivedChatMessages")

  @@index([googleId])
  @@index([role])
  @@map("users")
}

model Employee {
  id          String   @id @default(uuid())
  fullName    String
  email       String
  phone       String
  gender      String
  dob         DateTime @db.Date
  department  String
  position    String
  salary      Int
  joiningDate DateTime @db.Date
  status      String
  address     String
  profilePhoto String?  // Optional relative file path string for Employee photo
  role        String    @default("employee")

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaves Leave[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, status])
  @@index([userId, department])
  @@index([department])
  @@index([status])
  @@index([createdAt])
  @@map("employees")
}

model Notification {
  id          String   @id @default(uuid())
  title       String
  description String
  type        String   @default("info")
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, read])
  @@map("notifications")
}

model UserSettings {
  id             String  @id @default(uuid())
  notifyEmployee Boolean @default(true)
  notifySystem   Boolean @default(true)
  notifyLogin    Boolean @default(true)

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model Leave {
  id              String    @id @default(uuid())
  leaveType       String
  startDate       DateTime  @db.Date
  endDate         DateTime  @db.Date
  reason          String
  status          String    @default("PENDING")
  rejectionReason String?
  actionDate      DateTime?

  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  employeeId      String?
  employee        Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@index([employeeId])
  @@index([status])
  @@index([status, createdAt])
  @@map("leaves")
}



model ChatMessage {
  id         String    @id @default(uuid())
  senderId   String
  receiverId String
  content    String    @db.Text
  read       Boolean   @default(false)
  readAt     DateTime?
  isEdited   Boolean   @default(false)
  editedAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  sender     User      @relation("SentChatMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User      @relation("ReceivedChatMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId, receiverId])
  @@index([senderId])
  @@index([receiverId])
  @@index([receiverId, read])
  @@index([createdAt])
  @@map("chat_messages")
}




